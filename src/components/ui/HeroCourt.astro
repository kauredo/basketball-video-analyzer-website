---
// The phone hero's art. DESIGN.md puts the court in the page's geometry rather
// than its wallpaper: the three-point arc and the key belong to the hero, drawn
// as SVG line work, which costs nothing at runtime and survives 393px.
//
// This stands in for the 3D scene below sm, where that scene is not loaded at
// all. It is absolutely positioned inside the hero, so unlike the layer it
// replaces it cannot reappear behind body copy further down the page.
---

<div class="absolute inset-0 overflow-hidden pointer-events-none sm:hidden" aria-hidden="true">
  <div class="absolute inset-0 bg-gradient-to-b from-warm-100 via-warm-50 to-warm-50"></div>
  <svg
    class="absolute -right-24 -top-8 h-[115%] w-auto text-warm-400/70"
    viewBox="0 0 320 460"
    fill="none"
    stroke="currentColor"
    stroke-width="1.25"
  >
    <!-- the key, and the arc it feeds -->
    <rect x="96" y="0" width="128" height="190" />
    <circle cx="160" cy="190" r="60" />
    <path d="M8 0 V96 A152 152 0 0 0 312 96 V0" />
    <!-- centre circle, clipped by the section edge -->
    <circle cx="160" cy="452" r="58" />
    <line x1="0" y1="452" x2="320" y2="452" />
  </svg>
</div>

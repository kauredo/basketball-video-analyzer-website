---
// One captioned screenshot inside a guide page's reading column.
//
// A screenshot is not prose, so it breaks out of the column to the same 44rem
// the comparison tables use, and never wider than the viewport. At the column's
// own 512px a 2880px-wide app window renders its 13px UI text at about 2px;
// 704px is the width the home page's screenshots effectively get, so this is
// the floor rather than the goal. Cropping each shot to the panel its page
// argues about is the real fix and belongs with the next capture pass.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  /** What is on screen, not the word "screenshot". */
  alt: string;
  caption: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="my-10 relative left-1/2 -translate-x-1/2 w-[min(100vw-2rem,44rem)]">
  <div class="rounded-lg overflow-hidden shadow-lg">
    <Image
      src={src}
      alt={alt}
      widths={[704, 1408]}
      sizes="(min-width: 768px) 704px, calc(100vw - 2rem)"
    />
  </div>
  <!-- The caption is read, so it keeps a reading measure rather than the
       figure's width. -->
  <figcaption class="mt-3 max-w-lg text-sm text-warm-700">{caption}</figcaption>
</figure>

---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { DownloadButton } from '@/components/features/DownloadButton';
import { guides } from '@/data/guides';
import presentImg from '@/assets/screenshots/present-mode.png';
import HeroStage from '@/components/ui/HeroStage.astro';
import { getCachedLatestRelease } from '@/utils/cache';
import { fallbackReleaseData } from '@/utils/fallback';
import { jsonLd } from '@/utils/jsonLd';

import videoCuttingImg from '@/assets/screenshots/video-cutting-interface.png';
import projectOrgImg from '@/assets/screenshots/project-organization.png';
import categoryMgmtImg from '@/assets/screenshots/category-management.png';
import clipLibraryImg from '@/assets/screenshots/clip-library-browser.png';

const release = await getCachedLatestRelease() ?? fallbackReleaseData;

// Set to a YouTube video ID (e.g. 'dQw4w9WgXcQ') to enable the demo video section
const DEMO_VIDEO_ID = '';

// The app itself is described here only, not on every page.
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Basketball Video Analyzer',
  description: 'A free, open-source desktop app for cutting, tagging and exporting basketball game film. Built by a coach, for coaches.',
  url: 'https://basketballvideoanalyzer.com/',
  applicationCategory: 'SportsApplication',
  operatingSystem: 'Windows, macOS (Apple Silicon), Linux',
  softwareVersion: release.version,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  isAccessibleForFree: true,
  license: 'https://www.gnu.org/licenses/agpl-3.0.html',
  downloadUrl: 'https://github.com/kauredo/basketball-video-analyzer/releases/latest',
  installUrl: 'https://basketballvideoanalyzer.com/#download',
  screenshot: 'https://basketballvideoanalyzer.com/images/og-image.jpg',
  inLanguage: ['en', 'pt', 'es', 'fr', 'it', 'de', 'el', 'lt', 'sl', 'sr', 'tr'],
  featureList: [
    'Cut clips with keyboard shortcuts',
    'Hierarchical categories and saved presets',
    'Player tagging and court positions',
    'Drawing on paused video, replayed with the clip',
    'Present mode for film sessions',
    'Export to MP4 category folders, CSV, JSON or Sportscode-compatible XML',
  ],
  creator: { '@type': 'Person', name: 'kauredo', url: 'https://github.com/kauredo' },
  softwareHelp: { '@type': 'WebPage', url: 'https://github.com/kauredo/basketball-video-analyzer/issues' },
};

// Shown on the page and sent as FAQPage JSON-LD, so the two cannot drift.
const faq = [
  {
    q: 'Is it really free?',
    a: 'Yes. There is no paid tier, no trial and no account. The code is open source under the AGPL-3.0 licence, so anyone can read it on GitHub.',
  },
  {
    q: 'Does it upload my game film anywhere?',
    a: 'No. Videos, clips and projects stay in folders on your own computer. The app goes online only to check for updates, to import a YouTube video when you paste a link, and to send feedback when you write some.',
  },
  {
    q: 'Does it work offline?',
    a: 'Yes, apart from YouTube import and update checks. Cutting, tagging, drawing and exporting all run on your machine.',
  },
  {
    q: 'Does it run on Mac and Windows?',
    a: 'It runs on Windows 10 and later, on macOS 11 and later with an Apple Silicon chip (M1 or newer), and on Linux as a .deb or .rpm package. There is no build for Intel Macs.',
  },
  {
    q: 'Can I export to Sportscode, Hudl or Excel?',
    a: 'Clips export as MP4 files, one folder per category, which you can upload to Hudl, Google Drive or anywhere else. The clip list exports as CSV for Excel or Google Sheets, as JSON, or as a Sportscode-compatible timeline XML. There is no direct upload to Hudl.',
  },
  {
    q: 'Which video files does it open?',
    a: 'MP4, MOV, AVI, MKV, WMV, FLV, WebM and M4V.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<BaseLayout
  title="Free Basketball Video Analysis Tool"
  fullTitle="Basketball Video Analyzer | Free Video Analysis Software for Coaches"
  description="Free, open-source basketball video analysis for coaches. Cut and tag clips with keyboard shortcuts, draw on the film, and export them. Windows, macOS and Linux."
>

  <!-- ============================== -->
  <!-- HERO: copy, then the scroll stage -->
  <!-- ============================== -->
  <section aria-label="Hero" class="relative py-16">
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <!-- The headline holds the left, the action holds the right, and the
           stage below gets the whole width. The right side used to be 592x588
           of bare paper; putting the CTA there fills it without asking the
           fold to carry a second product image the stage would compete with. -->
      <div class="lg:flex lg:items-end lg:justify-between lg:gap-12">
        <div class="max-w-2xl lg:flex-1">
          <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-warm-900 leading-[1.1] mb-6 text-balance">
            Free basketball video analysis tool, built by a coach.
          </h1>
          <p class="text-xl text-warm-900 max-w-lg">
            I got tired of scrubbing through game tapes in VLC, so I built this. Mark plays, organize clips, export folders. That's it.
          </p>
        </div>

        <div class="mt-8 lg:mt-0 lg:shrink-0">
          <DownloadButton release={release} client:idle />
          <p class="text-sm text-warm-900 mt-4">
            <a href="#download" class="underline underline-offset-2 decoration-warm-400 hover:decoration-warm-900">Windows, macOS, and Linux</a>
            &middot; Free &amp; open source
          </p>
        </div>
      </div>

      <!-- Full measure, not the copy's 2xl, because a track needs the width. -->
      <div class="mt-10 lg:mt-12">
        <HeroStage />
      </div>
    </div>
  </section>


  <!-- ============================== -->
  <!-- THE APP: Product showcase      -->
  <!-- ============================== -->
  <section aria-label="Product showcase" class="py-16 sm:py-24 bg-warm-50 border-t border-warm-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="sr-only">The app</h2>
      <!-- Full measure, so the app's 13px UI text renders near 10px instead of
           the 4px it got in a 435px hero column. Below lg the container is too
           narrow for that, so the frame crops to an 11/10 box and shows the
           middle of the window at 0.57x rather than the whole of it at 0.27x.
           A screenshot nobody can read is decoration. -->
      <div class="overflow-hidden border border-warm-400 aspect-[11/10] lg:aspect-[2880/1382]">
        <Image
          src={videoCuttingImg}
          alt="Basketball Video Analyzer, video cutting interface showing the video player, timeline, and clip creator"
          class="w-full h-full object-cover"
          widths={[480, 720, 960, 1280, 1920]}
          sizes="(max-width: 1024px) 100vw, 1152px"
          format="webp"
          quality={82}
          loading="lazy"
        />
      </div>

      <p class="mt-4 text-sm text-warm-700 max-w-xl">
        The video pane, the scrub bar, and the marking controls. Z marks the start
        of a clip, M marks the end.
      </p>

      <!-- 3 callouts, not cards, just text -->
      <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-12">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <svg class="w-5 h-5 text-primary-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
            </svg>
            <h3 class="font-display font-semibold text-warm-900">Mark clips with keyboard shortcuts</h3>
          </div>
          <p class="text-warm-700 text-sm leading-relaxed">
            Z marks the start, M marks the end, Space plays. Arrow keys step one frame.
          </p>
        </div>

        <div>
          <div class="flex items-center gap-2 mb-2">
            <svg class="w-5 h-5 text-primary-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
            </svg>
            <h3 class="font-display font-semibold text-warm-900">Organize with hierarchical categories</h3>
          </div>
          <p class="text-warm-700 text-sm leading-relaxed">
            Nest subcategories under a parent: Pick &amp; Roll and Isolation both live under Offense.
          </p>
        </div>

        <div>
          <div class="flex items-center gap-2 mb-2">
            <svg class="w-5 h-5 text-primary-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <h3 class="font-display font-semibold text-warm-900">Export organized clip folders</h3>
          </div>
          <p class="text-warm-700 text-sm leading-relaxed">
            One click exports all your clips into category-based folders. Ready to share with staff or players.
          </p>
        </div>
      </div>
    </div>
  </section>


  <!-- ============================== -->
  <!-- VIDEO DEMO (shows when ID set) -->
  <!-- ============================== -->
  {DEMO_VIDEO_ID && (
    <section aria-label="Demo video" class="py-16 sm:py-24 bg-warm-100 border-t border-warm-300">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-warm-900 mb-4">
          See it in action
        </h2>
        <p class="text-warm-700 mb-10 max-w-lg mx-auto">
          Watch a quick walkthrough of the full workflow, from importing game tape to exporting organized clips.
        </p>
        <div class="relative w-full overflow-hidden border border-warm-400" style="padding-bottom: 56.25%">
          <iframe
            class="absolute inset-0 w-full h-full"
            src={`https://www.youtube.com/embed/${DEMO_VIDEO_ID}`}
            title="Basketball Video Analyzer Demo"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </section>
  )}


  <!-- ============================== -->
  <!-- HOW IT WORKS: 3 steps          -->
  <!-- ============================== -->
  <section aria-label="How it works" class="py-20 sm:py-28 bg-warm-100 border-t border-warm-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-warm-900 mb-10 sm:mb-14">
        How it works
      </h2>

      <!-- A scorebook page: numbered rows on one axis, ruled between. The old
           layout was three two-column grids with items-center and space-y-24,
           which centred three lines of copy against a tall screenshot and left
           a gap the height of the image above and below it. It also alternated
           lg:order-1 / lg:order-2, so no two screenshots shared an edge and the
           eye had no axis to follow. Top-aligned rows on one axis collapse the
           dead space; the rule does the dividing the whitespace was failing to
           do. The ordinal sits in its own gutter column, which separates it
           from the title it marks better than a colour ever did. -->
      <ol class="space-y-0">
        <li class="grid grid-cols-[2rem_1fr] lg:grid-cols-[3rem_minmax(0,24rem)_minmax(0,36rem)] gap-x-4 lg:gap-x-12 gap-y-6 items-start py-10 sm:py-14 border-t border-warm-300 first:border-t-0 first:pt-0">
          <span class="font-body text-sm font-medium text-warm-700 tabular-nums pt-1">1</span>
          <div>
            <h3 class="font-display text-xl font-semibold text-warm-900 mb-3">Load your game tape</h3>
            <p class="text-warm-700 leading-relaxed">
              Drag in any video file. Create a project for each game, opponent, or practice session so everything stays organized from the start.
            </p>
          </div>
          <div class="col-start-2 lg:col-start-3 overflow-hidden border border-warm-400">
            <Image
              src={projectOrgImg}
              alt="Project organization view showing multiple games organized by opponent"
              class="w-full h-auto block"
              widths={[480, 720, 960]}
              sizes="(max-width: 1024px) 100vw, 36rem"
              format="webp"
              quality={80}
              loading="lazy"
            />
          </div>
        </li>
        <li class="grid grid-cols-[2rem_1fr] lg:grid-cols-[3rem_minmax(0,24rem)_minmax(0,36rem)] gap-x-4 lg:gap-x-12 gap-y-6 items-start py-10 sm:py-14 border-t border-warm-300 first:border-t-0 first:pt-0">
          <span class="font-body text-sm font-medium text-warm-700 tabular-nums pt-1">2</span>
          <div>
            <h3 class="font-display text-xl font-semibold text-warm-900 mb-3">Mark the plays that matter</h3>
            <p class="text-warm-700 leading-relaxed">
              Use keyboard shortcuts to set in/out points as you watch. Tag each clip with categories: pick-and-roll, fast break, zone defense, whatever fits your system.
            </p>
          </div>
          <div class="col-start-2 lg:col-start-3 overflow-hidden border border-warm-400">
            <Image
              src={categoryMgmtImg}
              alt="Category management showing hierarchical organization of play types"
              class="w-full h-auto block"
              widths={[480, 720, 960]}
              sizes="(max-width: 1024px) 100vw, 36rem"
              format="webp"
              quality={80}
              loading="lazy"
            />
          </div>
        </li>
        <li class="grid grid-cols-[2rem_1fr] lg:grid-cols-[3rem_minmax(0,24rem)_minmax(0,36rem)] gap-x-4 lg:gap-x-12 gap-y-6 items-start py-10 sm:py-14 border-t border-warm-300 first:border-t-0 first:pt-0">
          <span class="font-body text-sm font-medium text-warm-700 tabular-nums pt-1">3</span>
          <div>
            <h3 class="font-display text-xl font-semibold text-warm-900 mb-3">Export and share with your team</h3>
            <p class="text-warm-700 leading-relaxed">
              Export your clip library as organized folders: one folder per category, clips named clearly. Drop them in Google Drive, hand them to an assistant, or play them in the film room.
            </p>
          </div>
          <div class="col-start-2 lg:col-start-3 overflow-hidden border border-warm-400">
            <Image
              src={clipLibraryImg}
              alt="Clip library showing all marked clips organized by category"
              class="w-full h-auto block"
              widths={[480, 720, 960]}
              sizes="(max-width: 1024px) 100vw, 36rem"
              format="webp"
              quality={80}
              loading="lazy"
            />
          </div>
        </li>
      </ol>
    </div>
  </section>



  <!-- ============================== -->
  <!-- PRESENT: the feature a coach   -->
  <!-- uses in front of a team        -->
  <!-- ============================== -->
  <section aria-label="Present mode" class="pt-20 sm:pt-28 pb-10 sm:pb-12 bg-warm-50 border-t border-warm-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
        <div>
          <h2 class="font-display text-3xl sm:text-4xl font-bold text-warm-900 mb-4">
            Play them back in front of the team
          </h2>
          <p class="text-warm-700 leading-relaxed max-w-md">
            Filter to the clips you want and hit Present. They run back to back,
            full screen, with the clip title and a counter in the corner so you
            know how many are left. No dragging files into a separate player ten
            minutes before practice.
          </p>
        </div>
        <div class="overflow-hidden border border-warm-400">
          <Image
            src={presentImg}
            alt="Present mode filling the window: a possession playing full screen, with Clip 1 of 10 above the title Transition, early rim run, a Transition category chip, and previous, play, next and repeat controls in the corner."
            widths={[512, 1024]}
            sizes="(min-width: 1024px) 512px, calc(100vw - 2rem)"
            format="webp"
            quality={80}
          />
        </div>
      </div>
    </div>
  </section>


  <!-- ============================== -->
  <!-- MORE: newer capabilities       -->
  <!-- ============================== -->
  <!-- No rule and no ground change above this one: it continues Present mode
       rather than dividing from it, which is what the pb-12/pt-12 pairing is
       for. The rule returns at Coaching guides. -->
  <section aria-label="More features" class="pt-10 sm:pt-12 pb-20 sm:pb-28 bg-warm-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-warm-900 mb-4">
        Okay, a few more things.
      </h2>
      <p class="text-warm-700 mb-6 max-w-lg">
        The loop is still cut, tag, export. These just make the film room easier.
      </p>

      <p class="text-warm-700 leading-relaxed max-w-lg">
        Pause the video and draw over the frame, and the markup travels with the
        exported clip. Tag who is in each clip and a season filters down to one
        player. The stats tab counts what you have charted, by category and by
        quarter.
      </p>

      <p class="text-warm-700 text-sm mt-8">
        Now in 11 languages, including Spanish, French, German, Italian, Turkish, and Greek.
      </p>
    </div>
  </section>


  <!-- ============================== -->
  <!-- GUIDES: link the content pages -->
  <!-- ============================== -->
  <!-- Same ground as the section above, divided by a rule rather than by a
       colour change, and on the page's own 6xl measure so it does not sit on a
       narrower axis than everything else. The footer indexes these six as well;
       what this section adds is the line under each one. -->
  <section aria-label="Coaching guides" class="py-20 sm:py-28 bg-warm-50 border-t border-warm-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-warm-900 mb-4">
        Coaching guides
      </h2>
      <p class="text-warm-700 mb-12 max-w-lg">
        Longer pieces on the parts that take practice rather than software.
      </p>

      <ul class="space-y-7 max-w-2xl">
        {guides.map((g) => (
          <li>
            <a href={g.href} class="group block">
              <span class="font-display font-semibold text-warm-900 group-hover:text-primary-600 transition-colors">
                {g.label}
              </span>
              <span class="block text-warm-700 text-sm leading-relaxed mt-1">{g.blurb}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>


  <!-- ============================== -->
  <!-- FAQ and system requirements    -->
  <!-- ============================== -->
  <section id="faq" aria-labelledby="faq-heading" class="py-20 sm:py-28 bg-warm-50 border-t border-warm-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="faq-heading" class="font-display text-3xl sm:text-4xl font-bold text-warm-900 mb-12">
        Questions coaches ask
      </h2>

      <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-16">
        <dl class="space-y-8 max-w-2xl">
          {faq.map(({ q, a }) => (
            <div>
              <dt class="font-display font-semibold text-warm-900">{q}</dt>
              <dd class="text-warm-700 leading-relaxed mt-2">{a}</dd>
            </div>
          ))}
        </dl>

        <aside aria-labelledby="requirements-heading" class="border-t border-warm-300 pt-8 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
          <h3 id="requirements-heading" class="font-display font-semibold text-warm-900 mb-5">
            System requirements
          </h3>
          <dl class="space-y-4 text-sm">
            <div>
              <dt class="font-medium text-warm-900">Windows</dt>
              <dd class="text-warm-700">Windows 10 or later, 64-bit</dd>
            </div>
            <div>
              <dt class="font-medium text-warm-900">macOS</dt>
              <dd class="text-warm-700">macOS 11 or later, Apple Silicon only</dd>
            </div>
            <div>
              <dt class="font-medium text-warm-900">Linux</dt>
              <dd class="text-warm-700">64-bit, .deb (Ubuntu 18.04 or later) or .rpm</dd>
            </div>
            <div>
              <dt class="font-medium text-warm-900">Memory and disk</dt>
              <dd class="text-warm-700">4 GB of RAM (8 GB recommended), 2 GB free plus room for your clips</dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />


  <!-- ============================== -->
  <!-- CTA: Open source + download    -->
  <!-- ============================== -->
  <section id="download" aria-label="Download" class="py-24 sm:py-32 bg-warm-100 border-t border-warm-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl sm:text-4xl font-bold text-warm-900 mb-6">
          Free forever. Open source.<br>
          The film never leaves your laptop.
        </h2>
        <p class="text-warm-700 mb-8 max-w-lg">
          No subscriptions, no feature gates, no data collection. Just a tool that does what it says. If you find a bug or want a feature, open an issue on GitHub.
        </p>

        <div class="flex flex-col sm:flex-row items-start justify-center gap-4 mb-8">
          <DownloadButton release={release} client:idle />
          <a
            href="https://github.com/kauredo/basketball-video-analyzer"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 text-warm-700 font-medium
              border border-warm-300 rounded-lg
              hover:border-warm-400 hover:bg-warm-100 transition-all"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </a>
        </div>

        <p class="text-sm text-warm-700">
          Windows, macOS, and Linux &middot; {release.version}
        </p>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={jsonLd(softwareSchema)} />

  <!-- HowTo Structured Data -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How to analyze basketball game footage",
